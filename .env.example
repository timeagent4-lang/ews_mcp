# Exchange 服务端固定地址；客户端不能通过工具指定服务器。
OUTLOOK_SERVER=exchange.example.com
# 不传个人密码时，使用以下公邮凭据代理访问 mailbox。
OUTLOOK_ADMIN_LANID=
OUTLOOK_ADMIN_PASSWORD=

# Streamable HTTP /mcp?key=...，缺少 key 服务不启动。
EWS_MCP_API_KEY=
EWS_MCP_HOST=127.0.0.1
EWS_MCP_PORT=7805
EWS_MCP_HTTP_TIMEOUT=300
# 提供发送邮件及会议通知能力时设为 true。
EWS_MCP_SEND_ENABLED=false

# 原附件下载可选；其余工具不需要本地数据目录。
EWS_MCP_DOWNLOAD_ENABLED=false
EWS_MCP_DATA_DIR=
EWS_MCP_PUBLIC_BASE_URL=
# 下载签名密钥至少 32 字节，独立于 MCP API key。
EWS_MCP_DOWNLOAD_SECRET=
EWS_MCP_DOWNLOAD_TTL_SECONDS=600
EWS_MCP_DOWNLOAD_RETENTION_SECONDS=86400
EWS_MCP_DOWNLOAD_MAX_BYTES=5242880
EWS_MCP_DOWNLOAD_CACHE_MAX_BYTES=1073741824
EWS_MCP_DOWNLOAD_CACHE_MAX_FILES=1000
EWS_MCP_DOWNLOAD_CLEANUP_SECONDS=300
