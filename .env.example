OA_BASE_URL=
OA_PATH=
SVC_CD=
SVC_SCN=
CNSMR_SYS_ID=
TLR_NO=
OA_TIMEOUT=
OUTLOOK_ADMIN_LANID=
OUTLOOK_ADMIN_PASSWORD=
OUTLOOK_ADMIN_EMAIL=
outlook_host=
EWS_MCP_DATA_DIR=
EWS_MCP_SEND_ENABLED=
EWS_MCP_HOST=
EWS_MCP_PORT=
MAIL_LOCAL_TIMEZONE=
EWS_MCP_HTTP_TIMEOUT=

# 宿主机日志目录（Compose）；容器内路径由Compose设为/logs。
# 按日期保存errors/audit，保留最近30个自然日；部署前准备目录及appuser权限。
EWS_MCP_LOG_HOST_DIR=./logs
EWS_MCP_LOG_DIR=/logs

# HTTP 鉴权：MCP 入口 /mcp 的共享密钥（随机长串）。留空则服务拒绝启动。
EWS_MCP_API_KEY=

# 团队共享联系人目录注册表（JSON，单行）。留空 = 关闭共享目录能力，个人 Contacts 不受影响。
# directory_id 是逻辑标识；mailbox/folder_id 必须是已核实的真实值，不能写显示名或邮箱地址。
# members 是唯一授权名单（LANID，读与建共用一份），不能从服务账号的 Editor 权限推导。
# 例：EWS_MCP_TEAM_DIRECTORIES={"team-customers":{"display_name":"团队客户通讯录","mailbox":"x@hkbea.com",
#"folder_id":"AAMk...","parent_folder_id":"AAMk...","folder_class":"IPF.Contact","members":["lch04655043"]}}
# 详见 docs/shared-contacts-directory.md
EWS_MCP_TEAM_DIRECTORIES=

# 附件上传（独立于下载/发送开关）。PUBLIC_BASE_URL 使用 Agent 实际可访问的同端口地址。
EWS_MCP_UPLOAD_ENABLED=false
EWS_MCP_PUBLIC_BASE_URL=
EWS_MCP_UPLOAD_MAX_BYTES=10485760
EWS_MCP_UPLOAD_CACHE_MAX_BYTES=1073741824
EWS_MCP_UPLOAD_CACHE_MAX_FILES=1000
EWS_MCP_UPLOAD_TTL_SECONDS=600
EWS_MCP_UPLOAD_RETENTION_SECONDS=86400
EWS_MCP_UPLOAD_CLEANUP_SECONDS=300
EWS_MCP_UPLOAD_DRAFT_MAX_BYTES=20971520
EWS_MCP_UPLOAD_DRAFT_MAX_ATTACHMENTS=20
# 上传启用时必须为正；不改变上传禁用时其他工具的既有 TTL 语义。
EWS_MCP_PREVIEW_TTL_SECONDS=1800
